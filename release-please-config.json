{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'simplymail' || @.name.value == 'simplymail-core' || @.name.value == 'simplymail-mail' || @.name.value == 'simplymail-store' || @.name.value == 'simplymail-ai' || @.name.value == 'simplymail-secrets' || @.name.value == 'simplymail-app' || @.name.value == 'simplymail-html')].version"
        }
      ]
    }
  }
}
